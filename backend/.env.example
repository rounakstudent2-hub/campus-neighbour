# Campus Neighbor - Backend Configuration
PROJECT_NAME="CampusNeighbor API"
VERSION="2.0.0"
ENVIRONMENT="development"
PORT=8000

# Security
JWT_SECRET="super-secret-neighborhood-marketplace-key-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL or local SQLite fallback)
DATABASE_URL="sqlite:///./campus_neighbor.sqlite"
# For PostgreSQL:
# DATABASE_URL="postgresql://campus_user:campus_password@localhost:5432/campus_neighbor"
DATABASE_SSL=false

# AI Microservice Connection
AI_SERVICE_URL="http://localhost:8001"

# Payment Gateway (Razorpay Test Keys)
RAZORPAY_KEY_ID="rzp_test_campusneighbor"
RAZORPAY_KEY_SECRET="dummy_secret"

# Allowed CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
