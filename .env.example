PORT=5001
JWT_SECRET=your-jwt-secret-key-change-in-production
NODE_ENV=development

# Database configuration:
# Defaults to local SQLite at server/database/marketplace.sqlite if DATABASE_URL is not set.
# To connect to PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/marketplace
# DATABASE_SSL=false

# Razorpay Payment Gateway credentials (optional test simulation fallback if left blank):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
